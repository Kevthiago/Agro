# Segredos da Edge Function publish-site. NUNCA coloque valores reais aqui nem
# em nenhum arquivo do repositório. No projeto hospedado:
#   npx supabase secrets set DEPLOY_HOOK_URL=... ALLOWED_ORIGINS=...
# Para testar localmente, copie para um arquivo FORA do repositório e use
#   npx supabase functions serve publish-site --env-file <caminho>
# (SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY o Supabase injeta sozinho.)

# Deploy hook do Cloudflare Pages (Settings > Builds > Deploy hooks).
DEPLOY_HOOK_URL=

# Origens que podem chamar a função pelo navegador, separadas por vírgula, sem barra no fim.
# Ex.: https://<seu-site>.pages.dev,https://<seu-dominio>
ALLOWED_ORIGINS=
