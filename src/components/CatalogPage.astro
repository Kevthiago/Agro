---
import Base from "@/layouts/Base.astro";
import CategoryNav from "@/components/CategoryNav.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  /** Slug da categoria atual; ausente em /produtos. */
  current?: string;
}

const { title, description, heading, current } = Astro.props;
---

<Base title={title} description={description}>
  <section class="catalogo">
    <h1>{heading}</h1>
    <CategoryNav current={current} />
    <slot name="busca" />
    <div class="lista">
      <slot />
    </div>
  </section>
</Base>

<style>
  .catalogo {
    max-width: 72rem;
    margin-inline: auto;
    padding: 3rem 1rem 4.5rem;
  }

  h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(3rem, 7vw, 4.5rem);
    color: var(--color-petroleo-escuro);
  }

  .lista {
    margin-top: 3rem;
  }

  @media (min-width: 48rem) {
    .catalogo {
      padding-inline: 1.75rem;
    }
  }
</style>
