---
import { buildWhatsAppLink, whatsappDisplayNumber } from "@/lib/whatsapp";

interface Props {
  /** Produto da conversa; sem ele a mensagem é o atendimento genérico. */
  productName?: string;
  class?: string;
}

const { productName, class: className } = Astro.props;
const href = buildWhatsAppLink(productName);
---

<!--
  Etiqueta de balcão pendurada por um barbante. Fica presa ao topo do
  ancestral posicionado mais próximo (position: relative).
  Ajustes pelo pai: --tag-right (posição) e --tag-cord (cor do barbante,
  clareie sobre fotos escuras).
-->
<a class:list={["tag", className]} href={href} target="_blank" rel="noopener">
  <span class="corpo">
    <b>Chama no WhatsApp</b>
    <span class="linha">{productName ? "Pergunte por este produto" : "Fale direto com a loja"}</span>
    <small>{whatsappDisplayNumber}</small>
  </span>
</a>

<style>
  .tag {
    --tag-string: 56px;
    --tag-width: 176px;
    position: absolute;
    top: 0;
    right: var(--tag-right, 1.5rem);
    z-index: 2;
    display: block;
    padding-top: var(--tag-string);
    color: var(--color-tinta);
    text-decoration: none;
    transform-origin: 50% 0;
    transform: rotate(4deg);
    transition: transform 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
    /* sombra no pai: o clip-path do corpo cortaria um box-shadow */
    filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.35));
  }

  /* barbante: desce até o furo */
  .tag::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    width: 2px;
    height: calc(var(--tag-string) + 20px);
    margin-left: -1px;
    background: var(--tag-cord, #7d8f8b);
  }

  .tag:hover,
  .tag:focus-visible {
    transform: rotate(-3deg);
  }

  .tag:focus-visible {
    outline-offset: 6px;
  }

  .corpo {
    display: block;
    width: var(--tag-width);
    padding: 34px 20px 20px;
    background: var(--color-laranja);
    clip-path: polygon(18% 0, 82% 0, 100% 14%, 100% 100%, 0 100%, 0 14%);
    /* furo de verdade: deixa ver o que está atrás da etiqueta */
    mask: radial-gradient(circle 7px at 50% 20px, transparent 6.5px, #000 7.5px);
  }

  b {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.85rem;
    line-height: 0.95;
  }

  .linha {
    display: block;
    margin-top: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  small {
    display: block;
    margin-top: 2px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .tag {
      --tag-string: 70px;
      --tag-width: 210px;
    }

    .corpo {
      padding: 36px 26px 24px;
    }

    b {
      font-size: 2.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag {
      transition: none;
    }

    .tag:hover,
    .tag:focus-visible {
      transform: rotate(4deg);
    }
  }
</style>
