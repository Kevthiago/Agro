---
import NewTabHint from "@/components/NewTabHint.astro";
import WhatsAppTag from "@/components/WhatsAppTag.astro";
import { site } from "@/config/site";
import { telHref } from "@/lib/contact";
---

<section id="contato" class="contato" aria-labelledby="contato-titulo">
  <div class="grade">
    <div class="texto">
      <h2 id="contato-titulo">Contato</h2>
      <p class="abre">
        O jeito mais rápido é o WhatsApp: pergunte se tem, tire dúvidas e faça o pedido direto com a
        loja.
      </p>

      <!-- outros canais, em linhas como as de um caderno de balcão -->
      <dl>
        <div>
          <dt>Telefones</dt>
          <dd class="fones">
            {site.phones.map((phone) => (
              <a href={telHref(phone)}>{phone}</a>
            ))}
          </dd>
        </div>
        <div>
          <dt>E-mail</dt>
          <dd>
            <a href={`mailto:${site.email}`} class="email">
              {site.email}
            </a>
          </dd>
        </div>
        <div>
          <dt>Instagram</dt>
          <dd>
            <a href={site.instagram.url} target="_blank" rel="noopener">
              {site.instagram.handle}
              <NewTabHint />
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <!-- a etiqueta fica pendurada num varal (a linha de cima) -->
    <div class="varal">
      <WhatsAppTag />
    </div>
  </div>
</section>

<style>
  .contato {
    border-top: 1px solid color-mix(in srgb, var(--color-tinta) 15%, transparent);
  }

  .grade {
    display: grid;
    gap: 2.5rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 4rem 1rem 4.5rem;
  }

  h2 {
    font-size: clamp(2.75rem, 6vw, 3.5rem);
    color: var(--color-petroleo-escuro);
  }

  .abre {
    max-width: 30em;
    margin-top: 1.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }

  dl {
    margin-top: 2rem;
    border-top: 2px solid var(--color-tinta);
  }

  dl > div {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-tinta) 20%, transparent);
  }

  dt {
    font-weight: 700;
    color: var(--color-petroleo-escuro);
  }

  dd {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .fones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  /* e-mail é longo: Figtree, para não estourar no celular */
  .email {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }

  dd a {
    color: var(--color-tinta);
    text-decoration: underline 2px transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s;
  }

  dd a:hover {
    text-decoration-color: var(--color-laranja);
  }

  .varal {
    position: relative;
    min-height: 15rem;
    border-top: 2px solid var(--color-tinta);
    /* centraliza a etiqueta (176px de largura no celular, 210px a partir de 48rem) */
    --tag-right: calc(50% - 88px);
  }

  @media (min-width: 40rem) {
    dl > div {
      grid-template-columns: 8rem 1fr;
      align-items: baseline;
    }
  }

  @media (min-width: 48rem) {
    .grade {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 4rem;
      padding: 5rem 1.75rem 5.5rem;
    }

    .varal {
      min-height: 18rem;
      margin-top: 1rem;
      --tag-right: calc(50% - 105px);
    }
  }
</style>
