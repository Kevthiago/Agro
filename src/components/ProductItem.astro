---
import { Image } from "astro:assets";
import placeholder from "@/assets/placeholder-produto.svg";
import TicketLink from "@/components/TicketLink.astro";
import { buildWhatsAppLink } from "@/lib/whatsapp";
import type { Product } from "@/lib/types";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, description, imageUrl, available } = product;
// Foto ocupa ~12rem na prateleira; 2x para telas densas.
const photoWidths = [240, 480];
const photoSizes = "12rem";
---

<article class="item" data-em-falta={available ? undefined : ""}>
  <div class="foto">
    {imageUrl ? (
      <Image
        src={imageUrl}
        inferSize
        widths={photoWidths}
        sizes={photoSizes}
        alt={name}
        loading="lazy"
      />
    ) : (
      <img
        src={placeholder.src}
        width={placeholder.width}
        height={placeholder.height}
        alt={name}
        loading="lazy"
        decoding="async"
      />
    )}
    {!available && <span class="falta">Em falta</span>}
  </div>
  <h3>{name}</h3>
  <p>{description}</p>
  <div class="acao">
    <TicketLink
      href={buildWhatsAppLink(name)}
      label={available ? "Pedir no WhatsApp" : "Perguntar no WhatsApp"}
      srLabel={name}
    />
  </div>
</article>

<style>
  .item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .foto {
    position: relative;
    height: 9.5rem;
    margin-bottom: 0.875rem;
  }

  .foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    /* fundo branco das fotos de catálogo some contra a parede palha */
    mix-blend-mode: multiply;
  }

  [data-em-falta] .foto img {
    opacity: 0.45;
    filter: grayscale(1);
  }

  /* aviso como um papelzinho colado na frente do produto */
  .falta {
    position: absolute;
    left: 0;
    bottom: 0.75rem;
    padding: 0.25rem 0.625rem;
    background: var(--color-tinta);
    color: var(--color-palha);
    font-size: 0.8125rem;
    font-weight: 700;
    transform: rotate(-3deg);
  }

  h3 {
    font-size: 1.5625rem;
    line-height: 1;
    color: var(--color-tinta);
  }

  p {
    margin: 0.375rem 0 0.875rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: #3d4f54;
  }

  /* botões alinhados na mesma altura, logo acima da tábua */
  .acao {
    margin-top: auto;
  }
</style>
